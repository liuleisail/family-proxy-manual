#!/usr/bin/env bash
# Route managed devices through Z4Pro: Chinese IPv4 destinations are forwarded
# directly with SNAT; all other TCP/UDP traffic is handed to Mihomo TPROXY.
set -Eeuo pipefail

CONFIG=/etc/family-proxy-ui/router.env
STATE=/etc/family-proxy-ui/managed-ips
CN_LIST=/etc/family-proxy-ui/cn-ipv4.txt
NFT_TABLE=family_mihomo_direct
LEGACY_CHAIN=FAMILY_MIHOMO_AUTO
TABLE=family_mihomo_shared
PREF=3000
MARK=0x2000

source_config() {
  while IFS='=' read -r key value; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    case "$key" in
      FAMILY_LAN_PREFIX) FAMILY_LAN_PREFIX=$value;;
      FAMILY_PROXY_IP) FAMILY_PROXY_IP=$value;;
    esac
  done < "$CONFIG"
  [[ ${FAMILY_LAN_PREFIX:-} == *\. ]] || { echo "FAMILY_LAN_PREFIX invalid" >&2; exit 1; }
  [[ ${FAMILY_PROXY_IP:-} =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || { echo "FAMILY_PROXY_IP invalid" >&2; exit 1; }
}

valid_ip() {
  [[ $1 == "$FAMILY_LAN_PREFIX"* ]] || return 1
  local last=${1##*.}
  [[ $last =~ ^[0-9]+$ && $last -ge 2 && $last -le 254 ]]
}

clear_legacy_runtime() {
  while iptables -t mangle -D PREROUTING -j "$LEGACY_CHAIN" 2>/dev/null; do :; done
  iptables -t mangle -F "$LEGACY_CHAIN" 2>/dev/null || true
  iptables -t mangle -X "$LEGACY_CHAIN" 2>/dev/null || true
  while iptables -t nat -D POSTROUTING -j FAMILY_MIHOMO_DIRECT 2>/dev/null; do :; done
  iptables -t nat -F FAMILY_MIHOMO_DIRECT 2>/dev/null || true
  iptables -t nat -X FAMILY_MIHOMO_DIRECT 2>/dev/null || true
}

clear_policy_route() {
  ip -o rule show | awk '/lookup family_mihomo_(shared|auto_[0-9]+)/ {gsub(/:/,"",$1); print $1}' | while read -r pref; do
    ip rule del pref "$pref" 2>/dev/null || true
  done
  awk '$2 ~ /^family_mihomo_auto_/ {print $2}' /etc/iproute2/rt_tables 2>/dev/null | while read -r table; do
    ip route flush table "$table" 2>/dev/null || true
  done
  ip route flush table "$TABLE" 2>/dev/null || true
  sed -i -E '/[[:space:]]family_mihomo_(auto_)?[0-9]+$/d' /etc/iproute2/rt_tables
}

write_nft_rules() {
  local output=$1 ip managed_count=0
  local -a managed=()
  [[ -e "$STATE" ]] || install -m 600 /dev/null "$STATE"
  while IFS= read -r ip; do
    valid_ip "$ip" || continue
    managed+=("$ip")
    ((managed_count+=1))
  done < "$STATE"
  [[ -s "$CN_LIST" ]] || { echo "China IPv4 list missing: $CN_LIST" >&2; exit 1; }
  (( $(awk -F/ '$1 ~ /^[0-9.]+$/ && $2 ~ /^[0-9]+$/ {n++} END {print n+0}' "$CN_LIST") > 1000 )) || {
    echo "China IPv4 list validation failed" >&2
    exit 1
  }

  {
    echo "delete table inet $NFT_TABLE"
    echo "table inet $NFT_TABLE {"
    echo "  set managed4 { type ipv4_addr; elements = {"
    if (( managed_count )); then
      printf '    %s' "${managed[0]}"
      for ip in "${managed[@]:1}"; do printf ', %s' "$ip"; done
      echo
    fi
    echo "  } }"
    echo "  set cn4 { type ipv4_addr; flags interval; auto-merge; elements = {"
    awk -F/ '$1 ~ /^[0-9.]+$/ && $2 ~ /^[0-9]+$/ {printf "%s    %s", (n++ ? ",\n" : ""), $0} END {print ""}' "$CN_LIST"
    echo "  } }"
    echo "  chain prerouting {"
    echo "    type filter hook prerouting priority mangle; policy accept;"
    echo "    ip saddr @managed4 ip daddr 10.0.0.0/8 return"
    echo "    ip saddr @managed4 ip daddr 172.16.0.0/12 return"
    echo "    ip saddr @managed4 ip daddr 192.168.0.0/16 return"
    echo "    ip saddr @managed4 ip daddr 224.0.0.0/4 return"
    echo "    ip saddr @managed4 ip daddr @cn4 counter return"
    echo "    ip saddr @managed4 meta l4proto tcp counter tproxy ip to :7893 meta mark set $MARK accept"
    echo "    ip saddr @managed4 meta l4proto udp counter tproxy ip to :7893 meta mark set $MARK accept"
    echo "  }"
    echo "  chain postrouting {"
    echo "    type nat hook postrouting priority srcnat; policy accept;"
    echo "    ip saddr @managed4 ip daddr @cn4 oifname \"kvmbr0\" counter snat to $FAMILY_PROXY_IP"
    echo "  }"
    echo "}"
  } > "$output"
}

sync_rules() {
  source_config
  for _ in $(seq 1 30); do ss -lnt | grep -Eq '(:|\.)7893\b' && break; sleep 2; done
  ss -lnt | grep -Eq '(:|\.)7893\b' || { echo "Mihomo TPROXY listener not ready" >&2; exit 1; }

  nft add table inet "$NFT_TABLE" 2>/dev/null || true
  local rules
  rules=$(mktemp /run/family-mihomo-direct.XXXXXX.nft)
  trap 'rm -f "$rules"' RETURN
  write_nft_rules "$rules"
  nft -c -f "$rules"

  clear_legacy_runtime
  clear_policy_route
  grep -q "[[:space:]]$TABLE$" /etc/iproute2/rt_tables || printf '%s %s\n' "$PREF" "$TABLE" >> /etc/iproute2/rt_tables
  ip route replace local 0.0.0.0/0 dev lo table "$TABLE"
  ip rule add pref "$PREF" fwmark "$MARK/0xffffffff" lookup "$TABLE"
  nft -f "$rules"
}

stop_rules() {
  clear_legacy_runtime
  nft delete table inet "$NFT_TABLE" 2>/dev/null || true
  clear_policy_route
}

case "${1:-sync}" in
  sync) sync_rules;;
  stop) stop_rules;;
  *) exit 2;;
esac
