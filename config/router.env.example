# Copy to /etc/family-proxy-ui/router.env, replace only the values below,
# then run scripts/install-server.sh. Never commit the resulting file.

# Network identity (IPv4 LAN only)
FAMILY_LAN_CIDR=192.168.10.0/24
FAMILY_LAN_PREFIX=192.168.10.
FAMILY_PROXY_IP=192.168.10.10
FAMILY_ROUTER_IP=192.168.10.1
FAMILY_RESERVED_GATEWAY_IP=

# Persistent data path. Use an SSD-backed path with sufficient free space.
FAMILY_DOCKER_ROOT=/var/lib/family-proxy/docker
# Optional healthy-disk backup directory shown on the status page.
BACKUP_ROOT=/var/backups/family-proxy

# RouterOS API. Restrict API access on the router to FAMILY_PROXY_IP only.
ROUTER_HOST=192.168.10.1
ROUTER_USER=family_proxy
ROUTER_PASSWORD=replace_with_routeros_api_password

# The installer turns UI_PASSWORD into a PBKDF2 hash and removes this line.
UI_USERNAME=admin
UI_PASSWORD=replace_with_a_long_unique_password
# Base64 of the DNS dashboard's username:password. Root-readable only.
DNS_UPSTREAM_AUTH_B64=
