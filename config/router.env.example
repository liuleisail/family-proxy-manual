# Copy to /etc/family-proxy-ui/router.env, replace only the values below,
# then run scripts/install-server.sh. Never commit the resulting file.

# Network identity (IPv4 LAN only)
FAMILY_LAN_CIDR=192.168.10.0/24
FAMILY_LAN_PREFIX=192.168.10.
FAMILY_PROXY_IP=192.168.10.10
FAMILY_ROUTER_IP=192.168.10.1
FAMILY_RESERVED_GATEWAY_IP=
# LAN bridge carrying managed-device traffic; Z4Pro normally uses kvmbr0.
FAMILY_CAPTURE_INTERFACE=kvmbr0
# Optional: the same-LAN interface used for HomeKit source-policy routes.
# Keep it equal to the LAN bridge unless the HomeKit service uses another NIC.
FAMILY_HOMEKIT_ROUTE_INTERFACE=kvmbr0

# Persistent data path. Use an SSD-backed path with sufficient free space.
FAMILY_DOCKER_ROOT=/var/lib/family-proxy/docker
# Optional healthy-disk backup directory shown on the status page.
BACKUP_ROOT=/var/backups/family-proxy

# Router integration mode: auto, routeros, or standalone.
# auto uses RouterOS only when API credentials are provided and authenticated;
# leaving the RouterOS fields blank resolves to standalone mode.
ROUTER_MODE=auto
# RouterOS API. Restrict API access on the router to FAMILY_PROXY_IP only.
ROUTER_HOST=
ROUTER_USER=
ROUTER_PASSWORD=
# Synchronize only the RouterOS family_cn_ipv4 list after the weekly APNIC update.
# The transaction rejects large deltas and restores the previous list on failure.
ROUTER_CN_AUTO_SYNC=true

# Optional read-only WireGuard monitoring.
WIREGUARD_MOBILE_INTERFACE=back-to-home-vpn
WIREGUARD_MOBILE_LABEL=手机按需回家
WIREGUARD_SITE_INTERFACE=wg-home
WIREGUARD_SITE_LABEL=站点常驻互联
WIREGUARD_SITE_PROBE=192.168.20.1
WIREGUARD_SITE_PROBE_SOURCE=10.0.0.2
# RouterOS 7.21+ remote-access WireGuard. The maintenance card asks for the
# public hostname/IP per client; these values define the managed server side.
WIREGUARD_REMOTE_INTERFACE=family-remote-wg
WIREGUARD_REMOTE_PORT=51820
WIREGUARD_REMOTE_ADDRESS=10.66.0.1/24
# Leave blank to use FAMILY_PROXY_IP (MosDNS), then FAMILY_ROUTER_IP.
WIREGUARD_REMOTE_DNS=
WIREGUARD_REMOTE_CLIENT_ALLOWED=0.0.0.0/0
WIREGUARD_REMOTE_KEEPALIVE=25

# The installer turns UI_PASSWORD into a PBKDF2 hash and removes this line.
UI_USERNAME=admin
UI_PASSWORD=replace_with_a_long_unique_password
# Base64 of the DNS dashboard's username:password. Root-readable only.
DNS_UPSTREAM_AUTH_B64=
# MosDNS audit/core API used only by the full DNS regression command.
MOSDNS_API_URL=http://127.0.0.1:9099
# Public GEO assets try direct first, then this local proxy. Airport subscriptions never use it.
FAMILY_GEODATA_PROXY=http://127.0.0.1:7890
# Enable only after refresh-mihomo-geodata --check succeeds on this network.
MIHOMO_GEODATA_AUTO_UPDATE=false
# The one-click installer sets this to true until the LAN first-run wizard is completed.
SETUP_PENDING=false
