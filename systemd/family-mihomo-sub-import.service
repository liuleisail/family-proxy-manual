[Unit]
Description=Family Mihomo direct subscription importer
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/family-proxy-ui/router.env
Environment="http_proxy=" "https_proxy=" "all_proxy=" "HTTP_PROXY=" "HTTPS_PROXY=" "ALL_PROXY="
ExecStart=/usr/bin/python3 /opt/family-proxy-ui/family-mihomo-sub-import.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
# ZSpace exposes persistent Docker data below /tmp/zfsv3. A private /tmp would
# hide the real provider files and make the UI report an empty candidate pool.
PrivateTmp=false
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
